{
  "name": "stockify",
  "version": "1.0.0",
  "description": "A comprehensive open-source stock management and billing solution for small and medium-sized businesses. Built with React, Node.js, and MongoDB, featuring inventory tracking, customer management, sales analytics, and automated billing with multi-tier pricing support.",
  "main": "index.js",
  "keywords": [
    "stock-management",
    "inventory-tracking",
    "billing-system",
    "pos-system",
    "business-management",
    "small-business",
    "retail-management",
    "wholesale-billing",
    "customer-management",
    "sales-analytics",
    "barcode-generator",
    "invoice-generation",
    "react",
    "nodejs",
    "mongodb",
    "typescript",
    "open-source"
  ],
  "author": "Stockify Development Team <team@stockify.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Princelad/stockify.git"
  },
  "homepage": "https://github.com/Princelad/stockify#readme",
  "bugs": {
    "url": "https://github.com/Princelad/stockify/issues"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run dev",
    "start:dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:frontend",
    "clean": "rm -rf node_modules backend/node_modules frontend/node_modules",
    "reset": "npm run clean && npm run install:all",
    "vercel-build": "cd frontend && npm install && npm run build",
    "postinstall": "npm install --prefix backend && npm install --prefix frontend"
  },
  "type": "commonjs",
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.28.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-color": "^3.1.3",
    "@types/d3-ease": "^3.0.2",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-path": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/d3-time": "^3.0.4",
    "@types/estree": "^1.0.8",
    "@types/json-schema": "^7.0.15",
    "@types/qrcode": "^1.5.5",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@radix-ui/react-toast": "^1.2.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.12.1",
    "jspdf": "^3.0.2",
    "qrcode": "^1.5.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1"
  }
}
